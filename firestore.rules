rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function currentRole() {
      return signedIn()
        ? currentUser().data.systemRole
        : null;
    }

    function currentStatus() {
      return signedIn()
        ? currentUser().data.status
        : null;
    }

    function isActive() {
      return signedIn() && currentStatus() == 'ACTIVE';
    }

    function isMasterAdmin() {
      return isActive() && currentRole() == 'MASTER_ADMIN';
    }

    function isOrganizer() {
      return isActive() && currentRole() == 'ORGANIZER';
    }

    function isRegisteredUser() {
      return isActive() && currentRole() == 'REGISTERED_USER';
    }

    function isSystemAdmin() {
      return isMasterAdmin() || isOrganizer();
    }

    // ============================================================
    // GROUP MEMBERSHIP
    // IMPORTANT:
    // Document ID must always be:
    // groupId_userId
    // ============================================================

    function membershipId(groupId, userId) {
      return groupId + '_' + userId;
    }

    function isGroupMember(groupId) {
      return isActive() &&
        exists(
          /databases/$(database)/documents/groupMembers/$(membershipId(groupId, request.auth.uid))
        );
    }

    function groupMember(groupId, userId) {
      return get(
        /databases/$(database)/documents/groupMembers/$(membershipId(groupId, userId))
      );
    }

    function groupRole(groupId) {
      return isGroupMember(groupId)
        ? groupMember(groupId, request.auth.uid).data.role
        : null;
    }

    function isGroupOwner(groupId) {
      return isGroupMember(groupId) &&
        groupRole(groupId) == 'OWNER';
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId) &&
        (groupRole(groupId) == 'OWNER' ||
         groupRole(groupId) == 'ADMIN');
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{userId} {

      // A user may read only their own profile.
      // Master Admin may read users for administration.
      allow read: if isActive() &&
        (request.auth.uid == userId || isMasterAdmin());

      // New account provisioning.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.systemRole == 'REGISTERED_USER' &&
        request.resource.data.status == 'ACTIVE';

      // User may update only safe profile fields.
      // systemRole/status cannot be self-modified.
      allow update: if isActive() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.systemRole == resource.data.systemRole &&
        request.resource.data.status == resource.data.status;

      // Only Master Admin can delete system users.
      allow delete: if isMasterAdmin();
    }

    // ============================================================
    // GROUPS
    // ============================================================

    match /groups/{groupId} {

      allow read: if isGroupMember(groupId) ||
        isMasterAdmin() ||
        isOrganizer();

      // Registered users can create groups.
      allow create: if isRegisteredUser() &&
        request.resource.data.ownerId == request.auth.uid;

      // Owner has full group configuration control.
      allow update: if isGroupOwner(groupId);

      allow delete: if isGroupOwner(groupId) ||
        isMasterAdmin();
    }

    // ============================================================
    // GROUP MEMBERS
    // ID = groupId_userId
    // ============================================================

    match /groupMembers/{membershipId} {

      allow read: if signedIn();

      // Creation is restricted to group owner/admin through
      // controlled membership approval logic.
      allow create: if isActive() &&
        (
          (
            request.resource.data.groupId is string &&
            request.resource.data.userId is string &&
            isGroupAdmin(request.resource.data.groupId)
          )
          ||
          (
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.role == 'GUEST_MEMBER'
          )
        );

      // Owner/Admin can manage group roles,
      // but NEVER system roles.
      allow update: if isActive() &&
        isGroupAdmin(resource.data.groupId);

      allow delete: if isActive() &&
        (
          isGroupAdmin(resource.data.groupId) ||
          resource.data.userId == request.auth.uid ||
          isMasterAdmin()
        );
    }

    // ============================================================
    // MEMBERSHIP APPLICATIONS
    // ============================================================

    match /membershipApplications/{appId} {

      // Applicant can see their own application.
      // Group admin/owner can see applications for their group.
      allow read: if isActive() &&
        (
          resource.data.applicantId == request.auth.uid ||
          isGroupAdmin(resource.data.groupId) ||
          isMasterAdmin()
        );

      // User can submit an application only for themselves.
      allow create: if isActive() &&
        request.resource.data.applicantId == request.auth.uid &&
        request.resource.data.status == 'PENDING';

      // Only group Owner/Admin can approve or reject.
      allow update: if isActive() &&
        isGroupAdmin(resource.data.groupId) &&
        request.resource.data.applicantId == resource.data.applicantId;

      allow delete: if isMasterAdmin() ||
        (
          isActive() &&
          resource.data.applicantId == request.auth.uid &&
          resource.data.status == 'PENDING'
        );
    }

    // ============================================================
    // INVITATIONS
    // ============================================================

    match /invitations/{invitationId} {

      // Active authenticated users can read invitation information.
      allow read: if isActive();

      // Owner/Admin creates invitation.
      allow create: if isActive() &&
        isGroupAdmin(request.resource.data.groupId) &&
        request.resource.data.createdBy == request.auth.uid;

      // Owner/Admin may revoke/manage their invitation.
      allow update: if isActive() &&
        isGroupAdmin(resource.data.groupId);

      allow delete: if isActive() &&
        isGroupAdmin(resource.data.groupId);
    }

    // ============================================================
    // CONVERSATIONS
    // ============================================================

    match /conversations/{conversationId} {

      allow read: if isActive();

      allow create: if isActive();

      allow update: if isActive();

      allow delete: if isMasterAdmin();

      // ----------------------------------------------------------
      // CONVERSATION MESSAGES
      // ----------------------------------------------------------

      match /messages/{messageId} {

        allow read: if isActive();

        allow create: if isActive() &&
          request.resource.data.senderId == request.auth.uid;

        allow update: if isActive() &&
          resource.data.senderId == request.auth.uid;

        allow delete: if isActive() &&
          (
            resource.data.senderId == request.auth.uid ||
            isMasterAdmin()
          );
      }
    }

    // ============================================================
    // EMERGENCY ALERTS
    // ============================================================

    match /alerts/{alertId} {

      allow read: if isActive();

      allow create: if isActive() &&
        request.resource.data.senderId == request.auth.uid;

      // Sender can manage their own alert where applicable.
      allow update: if isActive() &&
        resource.data.senderId == request.auth.uid;

      allow delete: if isMasterAdmin() ||
        (
          isActive() &&
          resource.data.senderId == request.auth.uid
        );
    }

    // ============================================================
    // DEVICE TOKENS / FCM
    // ============================================================

    match /users/{userId}/deviceTokens/{tokenId} {

      allow read: if isActive() &&
        request.auth.uid == userId;

      allow create, update: if isActive() &&
        request.auth.uid == userId;

      allow delete: if isActive() &&
        request.auth.uid == userId;
    }

    // ============================================================
    // AUDIT LOGS
    // ============================================================

    // Clients NEVER write audit logs.
    // Sensitive operations must write them from trusted
    // Firebase Cloud Functions using Admin SDK.
    match /auditLogs/{logId} {

      allow read: if isMasterAdmin();

      allow create, update, delete: if false;
    }

    // ============================================================
    // SYSTEM SETTINGS
    // ============================================================

    match /systemSettings/{settingId} {

      allow read: if isActive();

      // Only Master Admin can modify global settings.
      allow create, update, delete: if isMasterAdmin();
    }

    // ============================================================
    // FUTURE BLOOD REQUEST SYSTEM
    // ============================================================

    match /bloodRequests/{requestId} {

      allow read: if isActive();

      allow create: if isActive() &&
        request.resource.data.createdBy == request.auth.uid;

      allow update: if isActive() &&
        (
          resource.data.createdBy == request.auth.uid ||
          isMasterAdmin()
        );

      allow delete: if isMasterAdmin() ||
        (
          isActive() &&
          resource.data.createdBy == request.auth.uid
        );
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}